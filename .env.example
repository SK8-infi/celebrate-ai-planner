# Copy to .env for local development (`npm run dev` loads it). Never commit .env.

# Required: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (defaults shown)
# Models tried in order: the next one is used if a model is overloaded, too slow or returns an unusable plan.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
PORT=8080
RATE_LIMIT_PER_MINUTE=10
# Set to true behind Cloud Run so rate limits use the real client IP from X-Forwarded-For.
TRUST_PROXY=false
